    "def center(mat):\n",
    "    # calculating the mean of each column\n",
    "    feature_means = mat.shape[1] * [1]\n",
    "    n_rows = mat.shape[0]\n",
    "    n_cols = mat.shape[1]\n",
    "\n",
    "    result_mat = np.ones_like(mat,dtype=float)\n",
    "\n",
    "    for col in range(n_cols):\n",
    "        current_sum = 0\n",
    "        for row in range(n_rows):\n",
    "            current_sum += mat[row,col]\n",
    "        \n",
    "        feature_means[col] = current_sum/n_rows\n",
    "    \n",
    "    for row in range(n_rows):\n",
    "        for col in range(n_cols):\n",
    "            result_mat[row,col] = mat[row,col] - feature_means[col]\n",
    "    return result_mat\n",
    "\n",
    "centered_mat = center(mat)\n",
    "print(centered_mat)"
   ]
  },
